# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real values never committed, but the .example templates are safe and
# should be (they carry no secrets, only placeholders and dev-safe defaults)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDEs / local AI-tooling config — not project content
.idea/
.vscode/
.claude/

# Auto-generated by `next dev` on every run (Next.js's own AI-agent guidance for this
# specific version) — not authored content, regenerates locally as needed.
AGENTS.md
CLAUDE.md


.vercel
